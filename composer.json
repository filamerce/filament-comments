{
    "name": "filamerce/filament-comments",
    "description": "Add comments to your Filament Resources.",
    "keywords": [
        "filamentphp",
        "comments",
        "laravel",
        "filament-comments"
    ],
    "homepage": "https://github.com/filamerce/filament-comments",
    "support": {
        "issues": "https://github.com/filamerce/filament-comments/issues",
        "source": "https://github.com/filamerce/filament-comments"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Parallax",
            "email": "luke@parall.ax",
            "role": "Developer"
        },
        {
            "name": "Webard",
            "email": "code@webard.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "illuminate/contracts": "^10.0 | ^11.0 | ^12.0",
        "symfony/html-sanitizer": "^6.1 | ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Filamerce\\FilamentComments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filamerce\\FilamentComments\\FilamentCommentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^8.0 | ^9.0 | ^10.0",
        "pestphp/pest": "^2.0 | ^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Filamerce\\FilamentComments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
